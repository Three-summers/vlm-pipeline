[Unit]
Description=vLLM VLM inference server (Qwen2.5-VL-7B)
Documentation=file:///srv/data/projects/vlm-pipeline/docs/DEPLOY.md
Wants=network-online.target nvidia-persistenced.service
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
# Edit User/Group and paths for your host (see docs/DEPLOY.md).
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/srv/data/projects/vlm-pipeline

Environment=PYTHONUNBUFFERED=1
Environment=PATH=/srv/data/projects/vlm-pipeline/venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VLMP_ROOT=/srv/data/projects/vlm-pipeline
Environment=VLM_MODEL_DIR=/srv/data/projects/vlm-pipeline/models/Qwen2.5-VL-7B-Instruct-AWQ
Environment=VLM_VENV=/srv/data/projects/vlm-pipeline/venv
Environment=VLM_GPU_UTIL=0.55
Environment=VLM_MAX_LEN=16384

ExecStart=/srv/data/projects/vlm-pipeline/scripts/run-vlm-server.sh 8001

# vLLM 加载 7B AWQ 模型约需 60-90s
TimeoutStartSec=300
Restart=on-failure
RestartSec=15

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
