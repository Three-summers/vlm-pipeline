[Unit]
Description=vLLM VLM inference server (Qwen2.5-VL-7B)
Documentation=https://github.com/<your-repo>/vlm-pipeline/docs/DEPLOY.md
Wants=network-online.target nvidia-persistenced.service
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
# == 部署前必须修改以下内容 ==
# User/Group：替换为实际运行用户
User=CHANGE_ME
Group=CHANGE_ME
# WorkingDirectory、ExecStart、PATH、各 VLMP_*/VLM_*：替换 <PROJECT_ROOT> 为仓库实际路径
WorkingDirectory=<PROJECT_ROOT>

Environment=PYTHONUNBUFFERED=1
Environment=PATH=<PROJECT_ROOT>/.venv-vllm/bin:/usr/local/cuda/bin:/opt/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VLMP_ROOT=<PROJECT_ROOT>
Environment=VLM_MODEL_DIR=<PROJECT_ROOT>/models/Qwen2.5-VL-7B-Instruct-AWQ
Environment=VLM_VENV=<PROJECT_ROOT>/.venv-vllm
Environment=VLM_GPU_UTIL=0.85
Environment=VLM_MAX_LEN=8192
Environment=VLM_ENFORCE_EAGER=1
Environment=VLLM_USE_V2_MODEL_RUNNER=0

ExecStart=<PROJECT_ROOT>/scripts/run-vlm-server.sh 8001

# eager 模式下 vLLM 加载 7B AWQ 模型通常约需 60-90s
TimeoutStartSec=300
Restart=on-failure
RestartSec=15

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
