[Unit]
Description=VLM Pipeline Web platform (Flask + Gunicorn)
Documentation=file:///srv/data/projects/vlm-pipeline/docs/DEPLOY.md
Wants=network-online.target vlm-server.service
After=network-online.target vlm-server.service
# VLM 推理服务建议在 Web 之前就绪；若暂时无 GPU 可去掉 Requires
Requires=vlm-server.service

[Service]
Type=simple
# Edit User/Group and paths for your host (see docs/DEPLOY.md).
User=CHANGE_ME
Group=CHANGE_ME
WorkingDirectory=/srv/data/projects/vlm-pipeline

Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/offline/envs/yolo-py311/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/srv/data/projects/vlm-pipeline
Environment=VLMP_ROOT=/srv/data/projects/vlm-pipeline
Environment=VLMP_DB=/srv/data/projects/vlm-pipeline/data/vlmp.db
Environment=VLMP_PYTHON=/opt/offline/envs/yolo-py311/bin/python
Environment=VLMP_PORT=8090
Environment=VLMP_ENV=/opt/offline/envs/yolo-py311

ExecStartPre=-/usr/bin/mkdir -p /srv/data/projects/vlm-pipeline/logs /srv/data/projects/vlm-pipeline/data /srv/data/projects/vlm-pipeline/output
ExecStartPre=/opt/offline/envs/yolo-py311/bin/python /srv/data/projects/vlm-pipeline/scripts/vlm-web-init.py
ExecStart=/srv/data/projects/vlm-pipeline/scripts/run-web.sh 8090

Restart=on-failure
RestartSec=10
TimeoutStartSec=60

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
